// ================= PRISMA SCHEMA (UPDATED) =================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * ================= ENUMS =================
 */

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  INFO
  DESIGNING
  DESIGN_REVIEW
  DESIGN_APPROVED
  PRINTING
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationType {
  ORDER_CONFIRMATION
  ORDER_STATUS_UPDATE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PROMOTION
  WELCOME
  PASSWORD_RESET
  LOYALTY_EARNED
  LOYALTY_REDEEMED
  LOYALTY_EXPIRING
  LOYALTY_REWARD
  LOYALTY_BIRTHDAY
  LOYALTY_REFERRAL
  DESIGN_UPLOADED
  DESIGN_APPROVED
  DISCOUNT
}

enum DeliveryType {
  POST
  COURIER
  COD_POST
  COD_COURIER
}

enum DesignStatus {
  PENDING_DESIGN
  IN_DESIGN
  WAITING_APPROVAL
  APPROVED
  REVISION
  REJECTED
}

enum DesignVersionStatus {
  DRAFT
  SENT_TO_USER
  APPROVED
  NEED_CHANGE
}

enum AttachmentType {
  PAYMENT_RECEIPT
  REFERENCE_IMAGE
  DESIGN_FILE
}

enum MessageType {
  INITIAL_NOTE /// پیام اولیه هنگام سفارش
  DESIGN_FEEDBACK /// پیام بعد از دیدن طراحی
  ADMIN_REPLY /// پاسخ ادمین
  DESIGN_SUBMITTED /// طرح ارسال شد توسط ادمین
  DESIGN_APPROVED /// تایید توسط مشتری
  DESIGN_REVISION /// درخواست اصلاح
}

enum ReviewCommentStatus {
  PENDING
  APPROVED
  REJECTED
  APPROVED_IF_EMPTY
}

/**
 * ================= USER =================
 */

enum AuthSessionStatus {
  PENDING
  APPROVED
  EXPIRED
}

model AuthSession {
  id String @id

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  status AuthSessionStatus @default(PENDING)

  telegramChatId String? @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([telegramChatId])
}

model User {
  id Int @id @default(autoincrement())

  email    String? @unique
  password String?

  phone String? @unique
  name  String

  authProvider String @default("EMAIL") // 👈 مهم

  role     Role    @default(USER)
  isActive Boolean @default(true)

  is2FAEnabled Boolean @default(false)
  twoFASecret  String?

  loyaltyPoints Int @default(0)

  // relations
  addresses Address[]
  orders    Order[]
  cart      Cart?

  reviews  Review[]
  wishlist Wishlist[]

  logs ActivityLog[]

  notificationPreference NotificationPreference?
  notifications          Notification[]

  designVersions OrderDesignVersion[] @relation("DesignerVersions")
  designComments DesignComment[]

  messages        OrderMessage[]
  attachments     OrderAttachment[]
  statusHistories OrderStatusHistory[]
  designRevisions DesignRevision[]     @relation("DesignerRevisions")

  // Loyalty
  birthDate    DateTime?
  referralCode String?   @unique
  referredById Int?
  referredBy   User?     @relation("ReferredBy", fields: [referredById], references: [id])

  // Bale login
  baleChatId      String?   @unique
  baleUsername    String?
  baleFirstName   String?
  baleConnectedAt DateTime?

  telegramId          BigInt?   @unique
  telegramUsername    String?
  telegramFirstName   String?
  telegramLastName    String?
  telegramConnectedAt DateTime?

  reviewsApproved Review[] @relation("ReviewApprover")

  authSessions AuthSession[]

  // Loyalty relations
  loyaltyWallet         LoyaltyWallet?
  loyaltyTransactions   LoyaltyTransaction[]
  loyaltyRedemptions    LoyaltyRedemption[]
  loyaltyDailyLogins    LoyaltyDailyLogin[]
  loyaltyBirthdayGrants LoyaltyBirthdayGrant[]
  referralsMade         LoyaltyReferral[]      @relation("ReferralReferrer")
  referralsReceived     LoyaltyReferral[]      @relation("ReferralReferred")
  referredUsers         User[]                 @relation("ReferredBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ================= ADDRESS =================
 */

model Address {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  title      String
  fullName   String?
  phone      String?
  address    String
  city       String
  province   String
  postalCode String

  isDefault Boolean @default(false)

  orders Order[]
}

/**
 * ================= CATEGORY =================
 */

model Category {
  id Int @id @default(autoincrement())

  name     String
  parentId Int?

  parent   Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children Category[] @relation("Subcategories")

  products Product[]
}

/**
 * ================= PRODUCT =================
 */

model Product {
  id Int @id @default(autoincrement())

  name        String
  slug        String  @unique
  description String?

  price         Int
  discountPrice Int?
  stock         Int

  reservedStock Int @default(0)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  lowStockAlert Int @default(5)

  shippingMethods ProductShippingMethod[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  reviews  Review[]
  wishlist Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  url    String
  isMain Boolean @default(false)
}

/**
 * ================= SHIPPING =================
 */

model ShippingMethod {
  id Int @id @default(autoincrement())

  basalamId Int? @unique

  name        String
  description String?

  baseCost                 Int
  additionalCost           Int  @default(0)
  additionalDimensionsCost Int?

  isPrivate Boolean @default(false)
  isActive  Boolean @default(true)

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductShippingMethod[]
  orders   Order[]
}

model ProductShippingMethod {
  id Int @id @default(autoincrement())

  productId        Int
  shippingMethodId Int

  product        Product        @relation(fields: [productId], references: [id])
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id])

  @@unique([productId, shippingMethodId])
}

/**
 * ================= CART =================
 */

model Cart {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  items CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())

  cartId    Int
  productId Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  quantity Int
}

/**
 * ================= ORDER =================
 */

model Order {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)

  orderCode    String?
  trackingCode String?

  paymentRef String?

  totalPrice     Int
  shippingCost   Int
  discountAmount Int @default(0)

  loyaltyPointsUsed Int @default(0)
  loyaltyDiscount   Int @default(0)

  addressId Int
  address   Address @relation(fields: [addressId], references: [id])

  deliveryType DeliveryType @default(POST)

  paymentRejectionReason String?

  shippingMethodId Int?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])

  items    OrderItem[]
  payments Payment[]

  // NEW
  messages      OrderMessage[]
  attachments   OrderAttachment[]
  statusHistory OrderStatusHistory[]

  // OLD (temporary keep)
  designFiles OrderDesignFile[]

  activityLogs ActivityLog[]

  designVersions OrderDesignVersion[] @relation("OrderDesignVersions")

  comments DesignComment[]

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId   Int
  productId Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Int

  // NEW
  designStatus DesignStatus @default(PENDING_DESIGN)

  revisions DesignRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderMessage {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId  Int?
  isAdmin Boolean @default(false)

  type MessageType

  message String

  attachments OrderAttachment[]

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model OrderAttachment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  messageId Int?
  message   OrderMessage? @relation(fields: [messageId], references: [id])

  uploadedById Int?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id])

  type AttachmentType

  url String

  originalName String?

  mimeType String?

  createdAt DateTime @default(now())
}

model DesignRevision {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  revision Int

  designerId Int?
  designer   User? @relation("DesignerRevisions", fields: [designerId], references: [id])

  designUrl String

  isApproved Boolean @default(false)

  feedback String?

  createdAt DateTime @default(now())
}

model OrderStatusHistory {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  changedById Int?
  changedBy   User? @relation(fields: [changedById], references: [id])

  fromStatus OrderStatus?
  toStatus   OrderStatus

  note String?

  createdAt DateTime @default(now())
}

/**
 * ================= DESIGN =================
 */

model OrderDesignFile {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  url  String
  type String

  createdAt DateTime @default(now())
}

model OrderDesignVersion {
  id Int @id @default(autoincrement())

  orderId Int

  order Order @relation("OrderDesignVersions", fields: [orderId], references: [id], onDelete: Cascade)

  version Int

  designerId Int?
  designer   User? @relation("DesignerVersions", fields: [designerId], references: [id])

  fileUrl String

  status DesignVersionStatus @default(DRAFT)

  isFinal Boolean @default(false)

  createdAt DateTime @default(now())
}

model DesignComment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  message     String
  isFromAdmin Boolean @default(false)

  createdAt DateTime @default(now())
}

/**
 * ================= PAYMENT =================
 */

model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  amount Int
  status PaymentStatus @default(PENDING)

  gateway String

  gatewayRef    String?
  transactionId String?

  createdAt DateTime @default(now())
}

/**
 * ================= REVIEW / WISHLIST =================
 */

model Review {
  id Int @id @default(autoincrement())

  productId Int
  userId    Int
  orderId   Int?

  rating  Int
  comment String?

  isApproved Boolean @default(false)

  approvedAt DateTime?
  approvedBy Int?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  approver User? @relation("ReviewApprover", fields: [approvedBy], references: [id])

  @@unique([userId, productId, orderId])
}

model Wishlist {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

/**
 * ================= NOTIFICATION =================
 */

model NotificationPreference {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(true)

  orderUpdates Boolean @default(true)
  promotions   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  type    NotificationType
  channel NotificationChannel

  title   String
  message String

  status NotificationStatus @default(PENDING)

  scheduledAt DateTime?
  readAt      DateTime?

  metadata Json?

  createdAt DateTime @default(now())
}

/**
 * ================= LOGS =================
 */
enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum EntityType {
  USER
  PRODUCT
  ORDER
  PAYMENT
  DESIGN
  REVIEW
  CATEGORY
  SHIPPING_METHOD
  NOTIFICATION
  SYSTEM
  Api
  ACTIVITY_LOG
  API_LOG
  ERROR_LOG
  PERFORMANCE
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ActivityAction {
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_LOGIN_FAILED

  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_ROLE_CHANGED

  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  ORDER_STATUS_CHANGED

  ORDER_SHIPPED
  ORDER_DELIVERED

  PAYMENT_CREATED
  PAYMENT_SUCCESS
  PAYMENT_REJECTED
  PAYMENT_INITIATED
  PAYMENT_FAILED
  REFUND_REQUESTED

  DESIGN_UPLOADED
  DESIGN_APPROVED
  DESIGN_REVISION

  REVIEW_CREATED
  REVIEW_APPROVED

  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED

  ADMIN_VIEW_ACTIVITY_LOGS
  ADMIN_VIEW_API_LOGS
  ADMIN_VIEW_ERROR_LOGS
  ADMIN_VIEW_PERFORMANCE_LOGS
  ADMIN_SEARCH_LOGS
  ADMIN_VIEW_USER_LOGS
  ADMIN_VIEW_ANALYTICS

  API_REQUEST

  SYSTEM_EVENT
}

model ActivityLog {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  targetUserId Int?

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])

  actorType ActorType

  action ActivityAction

  entity   EntityType
  entityId String?

  severity LogSeverity @default(INFO)

  success Boolean @default(true)

  correlationId String?
  sessionId     String?

  metadata Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetUserId])
  @@index([orderId])
  @@index([action])
  @@index([entity])
  @@index([severity])
  @@index([createdAt])
  @@index([correlationId])
}

model ErrorLog {
  id         Int      @id @default(autoincrement())
  message    String
  stack      String?
  endpoint   String?
  method     String?
  ip         String?
  userId     Int?
  statusCode Int?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Discount {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  type         String // PERCENT | FIXED
  value        Int
  minPurchase  Int?
  maxUses      Int?
  usedCount    Int       @default(0)
  applicableTo String    @default("all")
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BankAccount {
  id         Int     @id @default(autoincrement())
  bankName   String
  holderName String
  cardNumber String
  sheba      String
  isActive   Boolean @default(true)
  priority   Int     @default(1)
}

model TourStep {
  id          Int     @id @default(autoincrement())
  page        String
  selector    String
  title       String
  description String
  order       Int     @default(1)
  placement   String  @default("bottom")
  isActive    Boolean @default(true)
}

/**
 * ================= LOYALTY SYSTEM =================
 */

enum LoyaltyTransactionType {
  EARN
  SPEND
  BONUS
  REFUND
  EXPIRE
  ADJUSTMENT
  CAMPAIGN
  REFERRAL
  REVIEW
  BIRTHDAY
  LOGIN
  FIRST_ORDER
  PROFILE_COMPLETED
}

enum LoyaltyTransactionSource {
  ORDER
  ADMIN
  CAMPAIGN
  REVIEW
  COUPON
  REFERRAL
  BIRTHDAY
  LOGIN
  API
  PROFILE
}

enum LoyaltyRuleEvent {
  ORDER_COMPLETED
  REVIEW
  DAILY_LOGIN
  BIRTHDAY
  REFERRAL_SIGNUP
  REFERRAL_FIRST_ORDER
  FIRST_ORDER
  PROFILE_COMPLETED
  REFUND
}

enum LoyaltyRewardType {
  DISCOUNT
  FREE_SHIPPING
  CREDIT
  COUPON
}

enum LoyaltyRedemptionStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

enum LoyaltyReferralStatus {
  PENDING
  REGISTERED
  FIRST_ORDER_COMPLETED
}

/**
 * 1) Loyalty Wallet — وضعیت فعلی امتیاز کاربر
 */
model LoyaltyWallet {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  availablePoints Int @default(0)
  pendingPoints   Int @default(0)
  lifetimeEarned  Int @default(0)
  lifetimeSpent   Int @default(0)
  lifetimeExpired Int @default(0)

  tierId Int?
  tier   LoyaltyTier? @relation(fields: [tierId], references: [id])

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loyaltyTransactions LoyaltyTransaction[]

  @@index([tierId])
}

/**
 * 2) Loyalty Ledger (Transaction) — هیچ‌وقت بدون ثبت تراکنش موجودی تغییر نمی‌کند
 */
model LoyaltyTransaction {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId Int?
  wallet   LoyaltyWallet? @relation(fields: [walletId], references: [id])

  points       Int // مثبت = دریافت، منفی = خرج/انقضا/برگشت
  balanceAfter Int // موجودی قابل استفاده بعد از این تراکنش

  type   LoyaltyTransactionType
  source LoyaltyTransactionSource

  description String?
  reference   String? // مثال: ORDER:123
  referenceId String?
  orderId     Int?

  ruleId     Int?
  rule       LoyaltyRule?     @relation(fields: [ruleId], references: [id])
  campaignId Int?
  campaign   LoyaltyCampaign? @relation(fields: [campaignId], references: [id])

  expireDate DateTime?

  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@index([expireDate])
}

/**
 * 3) Loyalty Tier — سطح کاربران
 */
model LoyaltyTier {
  id        Int     @id @default(autoincrement())
  name      String  @unique // BRONZE, SILVER, ...
  label     String // نمایش فارسی
  minPoints Int
  maxPoints Int? // null = بی‌نهایت
  color     String?
  benefits  Json?
  isActive  Boolean @default(true)

  wallets LoyaltyWallet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * 4) Rule Engine — قوانین داخل دیتابیس (بدون تغییر کد)
 */
model LoyaltyRule {
  id                Int                  @id @default(autoincrement())
  name              String
  event             LoyaltyRuleEvent
  points            Int
  multiplierApplies Boolean        @default(true)
  isActive        Boolean          @default(true)
  priority        Int              @default(0)
  conditions      Json? // { minAmount, categoryIds, ... }
  transactions    LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([event])
}

/**
 * 5) Campaign System — کمپین‌های امتیازی
 */
model LoyaltyCampaign {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  multiplier  Float    @default(1) // ضریب امتیاز
  bonus       Int      @default(0) // امتیاز جایزه ثابت
  priority    Int      @default(0)
  conditions  Json? // { categoryIds, productIds, minAmount, ... }
  isActive    Boolean  @default(true)

  transactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
}

/**
 * 6) Reward Catalog — کاتالوگ جوایز قابل تبادل
 */
model LoyaltyReward {
  id                 Int                 @id @default(autoincrement())
  title              String
  description        String?
  requiredPoints     Int
  rewardType         LoyaltyRewardType
  rewardValue        Int? // درصد یا مبلغ (ریال/تومان)
  rewardValueType    String? // PERCENT | FIXED
  active             Boolean             @default(true)
  limit              Int? // حداکثر دفعات تبادل کل
  redeemedCount      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  loyaltyRedemptions LoyaltyRedemption[]
}

/**
 * 7) Coupon Exchange / Redemption — ثبت تبادل امتیاز با جایزه
 */
model LoyaltyRedemption {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rewardId Int?
  reward   LoyaltyReward? @relation(fields: [rewardId], references: [id])

  points      Int
  rewardType  LoyaltyRewardType
  rewardValue Int?
  couponCode  String?                 @unique
  status      LoyaltyRedemptionStatus @default(PENDING)
  expiresAt   DateTime?
  usedAt      DateTime?
  orderId     Int?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([couponCode])
  @@index([status])
}

/**
 * 8) Referral — سیستم دعوت
 */
model LoyaltyReferral {
  id   Int    @id @default(autoincrement())
  code String @unique

  referrerId Int
  referrer   User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  referredId Int?
  referred   User? @relation("ReferralReferred", fields: [referredId], references: [id])

  status       LoyaltyReferralStatus @default(PENDING)
  registeredAt DateTime?
  firstOrderAt DateTime?

  referrerPoints Int @default(0)
  referredPoints Int @default(0)

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([referredId])
}

/**
 * 10) Daily Login — ورود روزانه
 */
model LoyaltyDailyLogin {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD
  points Int

  @@unique([userId, date])
  @@index([userId])
}

/**
 * 9) Birthday Reward log — ثبت سالانه تولد
 */
model LoyaltyBirthdayGrant {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  year   Int
  points Int

  @@unique([userId, year])
  @@index([userId])
}
